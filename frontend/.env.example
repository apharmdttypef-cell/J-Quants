# cdk deploy 後にCfnOutput ApiEndpoint の値をコピーする(末尾スラッシュなし)
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com

# ログイン(Cognito)。cdk deploy 後のCfnOutputから設定する。
# https://cognito-idp.ap-northeast-1.amazonaws.com/<CfnOutput UserPoolId>
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_xxxxxxxxx
# CfnOutput UserPoolClientId
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# CfnOutput CognitoDomain(末尾スラッシュなし)
VITE_COGNITO_DOMAIN=https://jquants-beta-vqvfk.auth.ap-northeast-1.amazoncognito.com
# ログイン後の戻り先(Cognitoのコールバック/ログアウトURLに登録済みのもの)。
# 省略時は開いているサイトのトップ(本番はCloudFrontのURL、ローカルは http://localhost:5173/)。
# VITE_REDIRECT_URI=http://localhost:5173/
